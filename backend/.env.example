# Copy to backend/.env and fill in. All services are local (no cloud).

# --- Postgres (Supabase local; system of record) ---
# Supabase CLI default is port 54322. For the bare postgres container use 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase Storage (raw files + rendered page images) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# --- Qdrant (chunk vectors) ---
QDRANT_URL=http://localhost:6333

# --- Models (served via Ollama or vLLM; OpenAI-compatible either way) ---
CHAT_MODEL=qwen3.5:35b
REASONING_MODEL=deepseek-r1:70b
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=true

# --- Retrieval / chunking ---
PREFETCH_LIMIT=30
TOP_K=6
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
