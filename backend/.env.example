# Copy to backend/.env and fill in. All services are local (no cloud).

# --- Postgres (Supabase local; system of record) ---
# Supabase CLI default is port 54322. For the bare postgres container use 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase Storage (raw files + rendered page images) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# --- Qdrant (chunk vectors) ---
QDRANT_URL=http://localhost:6333

# --- LLM serving (vLLM, OpenAI-compatible) ---
# vLLM serves one model per process. Run one server and point both roles at it, or run
# two servers and override CHAT_BASE_URL / REASONING_BASE_URL. The model name below must
# match each server's --served-model-name (defaults to the HF repo id you launched with).
# Pick a port nothing else on the box is using (check `ss -tlnp` first).
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
# CHAT_BASE_URL=http://localhost:8000/v1
# REASONING_BASE_URL=http://localhost:8001/v1

# --- Models ---
# Same model for both roles works fine (Qwen3 has native thinking mode, see main.py's
# _THINK_RE). Only set REASONING_MODEL to something different if you run a second server.
CHAT_MODEL=Qwen/Qwen3-14B
REASONING_MODEL=Qwen/Qwen3-14B
# Embeddings + reranker run locally via FlagEmbedding (not vLLM).
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=true

# --- Retrieval / chunking ---
PREFETCH_LIMIT=30
TOP_K=6
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
